{
  "name": "@metzia/sdk",
  "version": "0.1.1",
  "description": "The official TypeScript seller SDK for the Metzia agentic-commerce marketplace.",
  "keywords": [
    "metzia",
    "sdk",
    "marketplace",
    "agentic-commerce",
    "ai-agents",
    "mcp",
    "webhooks",
    "affiliate"
  ],
  "homepage": "https://github.com/metziaai/metzia-sdk#readme",
  "bugs": {
    "url": "https://github.com/metziaai/metzia-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metziaai/metzia-sdk.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "bin": {
    "market": "./bin/market.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "tsup"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
